# ---- Browser-safe (exposed in client bundle; VITE_ prefix required) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# ---- Server-only (NEVER prefix with VITE_, never commit real values) ----
# Set these in Supabase Edge Function secrets, not in the client build.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
AI_PROVIDER_API_KEY=your-ai-provider-key
AI_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=anthropic/claude-sonnet-5-5
EMBEDDING_PROVIDER_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ---- First-admin provisioning (scripts/provision-first-admin.mjs, local/CI only) ----
FIRST_ADMIN_EMAIL=principal@royalschool.example
FIRST_ADMIN_NAME=Principal
